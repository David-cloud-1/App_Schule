# Supabase — Required
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# WARNING: Never expose this key in the browser. Server-side only (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Protects the one-time badge migration endpoint (POST /api/badges/migrate)
# Set to any random secret string. If unset, the endpoint is open.
BADGE_MIGRATE_SECRET=your_random_secret_here

# Note: NEXT_PUBLIC_ vars are safe to expose in the browser.
# The anon key is protected by Supabase RLS policies.

# Anthropic Claude API — Required for PROJ-10 AI Question Generation
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# PROJ-51 Werkzeugkiste — Python-Kern (Vercel-Projekt werkzeugkiste-kern)
# Server-only. Das Kennwort muss im Kern-Projekt als KERN_SECRET denselben Wert haben.
WERKZEUGKISTE_KERN_URL=https://werkzeugkiste-kern.vercel.app
WERKZEUGKISTE_KERN_SECRET=your_random_secret_here

# Vercel Cron (täglich /api/cron/werkzeugkiste-aufraeumen). Vercel schickt es als Authorization: Bearer …
CRON_SECRET=your_random_secret_here

# Web-Push-Erinnerungen (PROJ-18). Schlüsselpaar erzeugen mit:
#   node -e "const k=require('web-push').generateVAPIDKeys();console.log(k)"
# Der öffentliche Schlüssel steckt beim Bauen im Browser-Code (NEXT_PUBLIC_), also vor dem Deploy setzen.
# Der private Schlüssel bleibt nur auf dem Server. Wird er getauscht, verlieren alle bisherigen Anmeldungen ihre Gültigkeit.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# Kontakt für die Push-Dienste (mailto:… oder https://…); ohne Angabe gilt die Adresse der Spedition-App
# VAPID_SUBJECT=https://spedilern.vercel.app

# Future variables (add as features are built):
# STRIPE_SECRET_KEY=sk_...
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# PROJ-129: Hauptschalter für Quiz-Varianten, Joker und Wette (an/aus, Standard aus)
QUIZ_VARIANTEN=aus
